# AskPeply Security Hardening
# Deny direct browser access to sensitive configuration files
<FilesMatch "^(\.env|\.env\.example|\.git|.*\.sql|.*\.log|.*\.md|.*\.zip)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Block PHP execution in upload/assets directories
Options -Indexes

